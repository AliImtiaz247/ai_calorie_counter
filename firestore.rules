rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfileCreate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'age', 'height',
          'currentWeight', 'targetWeight', 'gender',
          'activityLevel', 'goal'
        ])
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.height is number
        && request.resource.data.height > 0
        && request.resource.data.height <= 300
        && request.resource.data.currentWeight is number
        && request.resource.data.currentWeight > 0
        && request.resource.data.currentWeight <= 500
        && request.resource.data.targetWeight is number
        && request.resource.data.targetWeight > 0
        && request.resource.data.targetWeight <= 500;
    }

    function validProfileUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.height is number
        && request.resource.data.height > 0
        && request.resource.data.height <= 300
        && request.resource.data.currentWeight is number
        && request.resource.data.currentWeight > 0
        && request.resource.data.currentWeight <= 500
        && request.resource.data.targetWeight is number
        && request.resource.data.targetWeight > 0
        && request.resource.data.targetWeight <= 500;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if validProfileCreate(uid);
      allow update: if validProfileUpdate(uid);
      allow delete: if false;

      match /meals/{mealId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /water/{waterId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /weight_logs/{weightId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /weight/{weightId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /steps/{stepId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // AI scan history and quota counters are server-controlled.
      match /scans/{scanId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /ai_scan_usage/{dateId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /progress/{dateId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create, delete: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt']);
      }
    }

    // Backend-only daily scan limit records.
    match /scan_limits/{limitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
